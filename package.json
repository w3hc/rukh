{
  "name": "rukh",
  "version": "0.2.0",
  "description": "Nest.js-based AI agent starter kit",
  "author": "W3HC",
  "license": "LGPL-3.0-or-later",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch --config jest.config.ts",
    "test:cov": "jest --config ./test/jest-e2e.json && jest --coverage --config jest.config.ts",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config jest.config.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:concurrent": "jest test/concurrent-requests.e2e-spec.ts --config ./test/jest-e2e.json",
    "dance": "pnpm format && pnpm lint && pnpm build && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@langchain/core": "^1.1.49",
    "@langchain/mistralai": "^1.1.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ethers": "^6.17.0",
    "multer": "2.2.0",
    "puppeteer-core": "^25.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "w3pk": "^0.10.2"
  },
  "devDependencies": {
    "@jest/types": "^30.4.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "test-exclude": "^8.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "elliptic": ">=6.6.0",
      "ws": ">=8.17.1",
      "axios": ">=1.13.2",
      "pbkdf2": ">=3.1.5",
      "sha.js": ">=2.4.11",
      "form-data": ">=4.0.1",
      "base-x": ">=3.0.11",
      "undici": ">=5.29.0",
      "js-yaml": ">=4.1.0",
      "brace-expansion": ">=2.0.2",
      "tmp": ">=0.2.3",
      "minimatch": ">=9.0.0"
    }
  },
  "packageManager": "pnpm@10.23.0+sha1.b4a44ab0dc2adf2e36371d11d8eb0dc78ffc976c"
}