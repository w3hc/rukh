# Copy to .env and fill in. Only the two keys under "Required" are needed to
# boot: the app refuses to start without them.

# --- Required -----------------------------------------------------------------

# Mistral provider, also used by the RAG step to pick relevant context files
MISTRAL_API_KEY='88888'
# Anthropic provider, the default model
ANTHROPIC_API_KEY='88888'

# --- Optional providers -------------------------------------------------------
# Unset, a provider is skipped in the fallback chain.

OPENAI_API_KEY='88888'
DEEPSEEK_API_KEY='88888'
# Reasoning depth for the Anthropic streaming paths: low | medium | high |
# xhigh | max. Unset leaves the API default. Most of the output token budget
# on a long rewrite goes to reasoning, so this is the main cost/quality lever.
ANTHROPIC_EFFORT=

# --- Web search ---------------------------------------------------------------

# Tavily key for /web-reader/search (free key at https://tavily.com).
# Unset, that endpoint returns 503.
TAVILY_API_KEY='88888'

# --- Server -------------------------------------------------------------------

# HTTP port (default: 3000)
PORT=3000
# Environment name; 'test' disables NestJS Observe
NODE_ENV='dev'

# --- SIWE (auth on /context routes) -------------------------------------------

# Chain ID expected in SIWE messages (default: 1)
SIWE_CHAIN_ID=1
# Max validity window (issuedAt -> expirationTime) of a signature (default: 300)
SIWE_MAX_AGE_SECONDS=300
# Comma-separated allow-list of SIWE domains (default: any domain)
# SIWE_ALLOWED_DOMAINS=localhost:3001,rukh-ui.example.com

# --- Rate limiting ------------------------------------------------------------

# Requests per window (defaults: 1000/hour on /ask, 200/minute on /web-reader).
# Currently overridden by the @Throttle limits in src/config/rate-limit.config.ts
# (50/hour on /ask, 20/minute on /web-reader).
THROTTLE_ASK_LIMIT=1000
THROTTLE_WEB_LIMIT=200

# --- NestJS Observe (https://observe.nestjs.com) ------------------------------
# On only when both the key and the secret are set.

OBSERVE_APP_KEY='88888'
# Shown only once, at app creation
OBSERVE_APP_SECRET='88888'
# Identifies this instance in the dashboard (default: rukh)
# OBSERVE_SERVICE_ID=rukh
# Logs the agent's ingest activity
# OBSERVE_DEBUG=true

# --- Notifications (https://ntfy.sh) ------------------------------------------

# Push a notification when a new conversation starts on /ask.
# Unset, no notification is sent.
NTFY_ASK_TOKEN='88888'
# ntfy topic for those notifications (default: rukh)
# NTFY_ASK_TOPIC=rukh

# --- GitHub -------------------------------------------------------------------

# Personal access token with read:user and read:org scopes, for the GitHub
# sponsorship check in SubsService (not wired to any route yet)
GITHUB_API_TOKEN='88888'
