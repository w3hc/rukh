MISTRAL_API_KEY='88888'
ANTHROPIC_API_KEY='88888'
OPENAI_API_KEY='88888'
TAVILY_API_KEY='88888'  # Tavily API key for web search (optional - get free key at https://tavily.com)
PORT=3000
NODE_ENV='dev'
GITHUB_API_TOKEN='88888'  # GitHub Personal Access Token with read:user and read:org scopes
SIWE_CHAIN_ID=1  # Chain ID expected in SIWE messages authorizing /context requests
SIWE_MAX_AGE_SECONDS=300  # Max validity window (issuedAt -> expirationTime) for a SIWE signature
# SIWE_ALLOWED_DOMAINS=localhost:3001,rukh-ui.example.com  # optional comma-separated allow-list
OBSERVE_APP_KEY='88888'  # NestJS Observe app key (https://observe.nestjs.com)
OBSERVE_APP_SECRET='88888'  # NestJS Observe app secret, shown only once at creation
# OBSERVE_SERVICE_ID=rukh  # optional, identifies this instance in the dashboard (defaults to "rukh")
# OBSERVE_DEBUG=true  # optional, logs the agent's ingest activity

# Rate limiting (requests per window). Defaults: 1000/hour, 200/minute
THROTTLE_ASK_LIMIT=1000
THROTTLE_WEB_LIMIT=200
