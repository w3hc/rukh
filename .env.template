# Copy to .env and fill in. Only the "Required" group is needed for the first
# `pnpm start`: the app refuses to boot without both keys. Everything else is
# optional and switches a feature on; commented lines show their defaults.
# Values are validated at boot (src/config/env.validation.ts): a malformed one
# stops the app with a message naming it. Empty lines like `KEY=` count as unset.

# --- Required -----------------------------------------------------------------

# Mistral provider, also used by the RAG step to pick relevant context files
MISTRAL_API_KEY=
# Anthropic provider, the default model
ANTHROPIC_API_KEY=

# --- Optional: more providers -------------------------------------------------
# Unset, a provider is skipped in the fallback chain.

# OpenAI provider
OPENAI_API_KEY=
# DeepSeek provider
DEEPSEEK_API_KEY=
# Reasoning depth for the Anthropic streaming paths: low | medium | high |
# xhigh | max. Unset leaves the API default. Most of the output token budget
# on a long rewrite goes to reasoning, so this is the main cost/quality lever.
ANTHROPIC_EFFORT=

# --- Optional: web search -----------------------------------------------------

# Tavily key for /web-reader/search (free key at https://tavily.com).
# Unset, that endpoint returns 503.
TAVILY_API_KEY=

# --- Optional: SIWE (auth on /context routes) ---------------------------------

# Chain ID expected in SIWE messages
# SIWE_CHAIN_ID=1
# Max validity window (issuedAt -> expirationTime) of a signature, in seconds
# SIWE_MAX_AGE_SECONDS=300
# Comma-separated allow-list of SIWE domains. Unset, any domain is accepted.
# SIWE_ALLOWED_DOMAINS=localhost:3001,rukh-ui.example.com

# --- Optional: GitHub sponsorship ---------------------------------------------
# On only when SPONSOR_GITHUB_LOGIN is set. Provides SponsorshipService, not
# wired to any route yet.

# GitHub user or organization whose sponsors are checked
SPONSOR_GITHUB_LOGIN=
# Minimum active monthly sponsorship, in USD
# SPONSOR_MIN_MONTHLY_USD=5
# Personal access token with read:user and read:org scopes, required when
# SPONSOR_GITHUB_LOGIN is set
GITHUB_API_TOKEN=

# --- Optional: NestJS Observe (https://observe.nestjs.com) --------------------
# On only when both the key and the secret are set.

# App key from the Observe dashboard
OBSERVE_APP_KEY=
# App secret, shown only once, at app creation
OBSERVE_APP_SECRET=
# Identifies this instance in the dashboard
# OBSERVE_SERVICE_ID=rukh
# Logs the agent's ingest activity
# OBSERVE_DEBUG=true

# --- Optional: notifications (https://ntfy.sh) --------------------------------

# Token to push a notification when a new conversation starts on /ask.
# Unset, the notifications module is not loaded.
NTFY_ASK_TOKEN=
# ntfy topic for those notifications
# NTFY_ASK_TOPIC=rukh

# --- Server -------------------------------------------------------------------

# HTTP port
# PORT=3000
# Environment name, logged at boot; 'test' disables NestJS Observe
NODE_ENV=

# --- Rate limiting ------------------------------------------------------------
# Currently overridden by the @Throttle limits in src/config/rate-limit.config.ts
# (50/hour on /ask, 20/minute on /web-reader).

# Requests per hour on /ask
# THROTTLE_ASK_LIMIT=1000
# Requests per minute on /web-reader
# THROTTLE_WEB_LIMIT=200
